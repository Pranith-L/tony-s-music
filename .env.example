# ==============================================================================
# TONY PRAKASH OFFICIAL MUSIC PLATFORM — ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to backend/.env and frontend/.env respectively.
# NEVER commit real production secrets, database passwords, or private keys.

# ------------------------------------------------------------------------------
# 1. SUPABASE CLOUD CONFIGURATION (PostgreSQL 15, Auth, Storage)
# ------------------------------------------------------------------------------
# PostgreSQL Connection Strings
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# Supabase REST / Auth Keys
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_KEY=sb_publishable_[ANON_KEY]
SUPABASE_PUBLISHABLE_KEY=sb_publishable_[ANON_KEY]
SUPABASE_JWKS_URL=https://[PROJECT_REF].supabase.co/auth/v1/.well-known/jwks.json

# Frontend Supabase Variables (prefix with VITE_)
VITE_SUPABASE_URL=https://[PROJECT_REF].supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_[ANON_KEY]
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_[ANON_KEY]

# ------------------------------------------------------------------------------
# 2. SERVER & NETWORKING CONFIGURATION
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production
CLIENT_URL=https://tony-prakash-music.vercel.app
VITE_API_URL=/api
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters
SESSION_SECRET=your_super_secret_session_key_minimum_32_characters

# ------------------------------------------------------------------------------
# 3. CASHFREE PAYMENT GATEWAY CONFIGURATION
# ------------------------------------------------------------------------------
CASHFREE_APP_ID=TEST_YOUR_CASHFREE_APP_ID
CASHFREE_SECRET_KEY=TEST_YOUR_CASHFREE_SECRET_KEY
CASHFREE_ENV=sandbox # Switch to "production" when live
VITE_CASHFREE_ENV=sandbox

# ------------------------------------------------------------------------------
# 4. INSTAMOJO PAYMENT GATEWAY CONFIGURATION
# ------------------------------------------------------------------------------
INSTAMOJO_API_KEY=test_your_instamojo_api_key
INSTAMOJO_AUTH_TOKEN=test_your_instamojo_auth_token
INSTAMOJO_SALT=test_your_private_webhook_salt
INSTAMOJO_ENV=test # Switch to "production" when live

# ------------------------------------------------------------------------------
# 5. GOOGLE OAUTH 2.0 CREDENTIALS
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
