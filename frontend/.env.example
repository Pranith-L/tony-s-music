# ==============================================================================
# FRONTEND ENVIRONMENT VARIABLES — TONY PRAKASH WEB APP
# ==============================================================================

# Relative API Base URL (proxied by Vite in dev and Vercel edge in prod)
VITE_API_URL=/api

# Supabase Public Configuration
VITE_SUPABASE_URL=https://[PROJECT_REF].supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_[ANON_KEY]
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_[ANON_KEY]

# Google OAuth 2.0 Web Client ID
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Cashfree SDK Environment ("sandbox" or "production")
VITE_CASHFREE_ENV=sandbox
