{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://mrehomunxqccvcwpkwxd.supabase.co/functions/v1/hyper-responder/$1"
    },
    {
      "source": "/((?!assets/|covers/|robots.txt|sitemap.xml).*)",
      "destination": "/index.html"
    }
  ]
}
